    "X_val_seqs = X_val_seqs.astype(np.float32)\n",
    "\n",
    "N_bg = min(200, X_val_seqs.shape[0])       # background size\n",
    "N_explain = min(300, X_val_seqs.shape[0])  # number of examples to explain\n",
    "\n",
    "X_bg = torch.from_numpy(X_val_seqs[:N_bg])        # (N_bg, max_len, num_features)\n",
    "X_explain = torch.from_numpy(X_val_seqs[:N_explain])\n",
    "\n",
    "explainer = shap.DeepExplainer(wrapped_model, X_bg)\n",
    "shap_vals = explainer.shap_values(X_explain, check_additivity=False)   # regression: one output\n",
    "\n",
    "if isinstance(shap_vals, list):\n",
    "    shap_vals = shap_vals[0]   # shape: (N_explain, max_len, num_features)\n",
    "\n",
    "# average absolute SHAP over samples and time\n",
