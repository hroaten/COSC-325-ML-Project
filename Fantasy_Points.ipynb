    "sns.histplot(data=results, x='resid', hue='position', element='step', stat='density')\n",
    "plt.axvline(0, color='k', linestyle='--')\n",
    "plt.show()\n",
    "\n",
    "sns.scatterplot(data=results, x='true_fp_ppr', y='resid', hue='position', alpha=0.6)\n",
    "plt.axhline(0, color='k', linestyle='--')\n",
    "plt.show()\n",
    "\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "print(results.groupby('position').apply(lambda g: spearmanr(g.true_fp_ppr, g.pred_fp_ppr).correlation))\n",
    "\n",
    "# top-k overlap per week: for each week, compare top-N predicted vs true\n",
    "def topk_weekly(results, k=5):\n",
    "    overlaps = []\n",
    "    for (s,w), grp in results.groupby(['season','week']):\n",
    "        pred_top = set(grp.nlargest(k, 'pred_fp_ppr')['player_id'])\n",
    "        true_top = set(grp.nlargest(k, 'true_fp_ppr')['player_id'])\n",
    "        if len(pred_top)>0:\n",
    "            overlaps.append(len(pred_top & true_top)/k)\n",
    "    return np.mean(overlaps)\n",
    "\n",
    "print('Weekly top-5 overlap:', topk_weekly(results, k=5))\n",
    "\n",
    "# compute std of residuals per position on validation/test\n",
    "resid_std = results.groupby('position')['resid'].std()\n",
    "# 95% PI approx: pred +/- 1.96 * resid_std[position]\n",
    "\n",
    "# baseline: predict position mean (from train)\n",
    "pos_mean = train.groupby('position')['fantasy_points_ppr'].mean()\n",
    "results['pos_mean_pred'] = results['position'].map(pos_mean)\n",
    "print('Baseline RMSE (position mean):', mean_squared_error(results.true_fp_ppr, results.pos_mean_pred))\n",
    "\n",
    "results.assign(abs_err=results.resid.abs()).sort_values('abs_err', ascending=False).head(20)"
