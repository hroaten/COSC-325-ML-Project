    "                            num_layers=num_layers,\n",
    "                            batch_first=True,\n",
    "                            dropout=dropout,\n",
    "                            bidirectional=bidirectional)\n",
    "        self.fc = nn.Linear(hidden_size * self.bidirectional, 1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        # x: (batch, seq_len, input_size)\n",
    "        out, (hn, cn) = self.lstm(x)  # out: (batch, seq_len, hidden)\n",
    "        # take last time-step's output\n",
    "        last = out[:, -1, :]  # (batch, hidden_size * directions)\n",
    "        out = self.fc(last)\n",
